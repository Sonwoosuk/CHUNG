function fn_apply_print(){	
	
	temp = $("#apply_print").html();
	$("#print_area").html("<div class='board_view apply'><div class='apply_print'>"+temp+"</div></div>");

	$(".wrap").addClass("print_hide");

	window.print();
	
	setTimeout(function() {
		$("#print_area").html("");
		$(".wrap").removeClass("print_hide");
	}, 1000);

}

