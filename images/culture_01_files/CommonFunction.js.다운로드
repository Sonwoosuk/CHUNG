function uploadCheckfileMaxsize(obj, maxSize)
{
	var file_chk = obj.files;
	
	if(file_chk[0].size > 1024 * 1024 * maxSize){
		var now_size = file_chk[0].size / 1024 / 1024;
		now_size = now_size.toFixed(2);
		// 용량 초과시 경고후 해당 파일의 용량도 보여줌
		//alert(maxSize+'MB 이내의 파일만 등록할 수 있습니다.\n\n' + '현재 파일 용량 : ' + (Math.round(file_chk[0].size / 1024 / 1024 * 100) / 100) + 'MB');
		alert(maxSize+'MB 이내의 파일만 등록할 수 있습니다.\n\n' + '현재 파일 용량 : ' + now_size + 'MB');
		resetFile(obj);
		return;
	}
}

