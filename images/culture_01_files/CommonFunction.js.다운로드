function fn_input_value(obj){
	obj.val(fn_empty(obj.val()));

	return obj.val();
}


function fn_radio_value(obj){
	name = obj.attr("name");
	chk = $(':radio[name="'+name+'"]').is(':checked');
	
	if (chk == false)
	{
		return "";
	}else{
		return $(':radio[name="'+name+'"]:checked').val();
	}
}

function fn_checkbox_value(obj){
	name = obj.attr("name");
	chk = $(':checkbox[name="'+name+'"]').is(':checked');
	
	if (chk == false)
	{
		return "";
	}else{
		var val = $(':checkbox[name="'+name+'"]:checked').map(function(){ 
			return $(this).val();
		}).get().join();

		return val;
	}
}

