// 확장자 추출
//〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓
function getFileExtension(filePath){
	var index = -1;
	index = filePath.lastIndexOf('.');

	var extension = "";

	if(index != -1)
	{
		extension = filePath.substring(index+1, filePath.len);
	}
	else
	{
		extension = "";
	}

	return extension;
} 

