function uploadCheckFile(obj, maxSize)
{

  var value = obj.value;

	if (value != "")
	{
		uploadCheckfileMaxsize(obj, maxSize);

		var chk = "";

		var src = getFileExtension(value);
		if (src == "") {
			alert('올바른 파일을 입력하세요!');
			resetFile(obj);
			return;
		}

		var ext = src.toLowerCase();
		
		var ext_arr = new Array("jpg","jpeg","peg","gif","png","bmp","hwp","doc","docx","xls","xlsx","pdf","txt","ppt","pptx","zip","alz","mp4");
		
		for( var i=0; i < ext_arr.length; i++ ) {
			if (ext_arr[i] == ext)
			{
				chk = "Y";
				break;
			}
		}

		if (chk == "")
		{
			alert('"'+ext+'" 는 금지된 확장자입니다.');
			resetFile(obj);
			return;
		}
	}
}

