// 비밀번호 영문 대/소문자 숫자 조합, 공백 있는지 체크
//〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓
function checkPasswdAlphabetNumber(todo){
	
	var reg1 = true;

	if(todo.search(/\s/) != -1) { 
		//있음
		reg1 = false;
	} else { 
		//없음
		reg1 = true;
	}

	var reg2 = /[a-z]/g;    
	var reg3 = /[0-9]/g;
	var reg4 = /[A-Z]/g;

	return (reg1 &&  reg2.test(todo)  &&  reg3.test(todo) &&  reg4.test(todo));

}

