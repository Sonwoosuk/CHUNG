// 유튜브 사이즈 조절
//〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓
function resizeYoutube() {
	$("iframe").each(function() {
		var url = $(this).attr("src");

		if (url.includes("youtube.com/embed/") || url.includes("player.vimeo.com/video/") ){
			$(this).css("width", "100%");
			$(this).css("height", Math.ceil(parseInt($(this).css("width")) * 480 / 854) + "px");
		}
	});
}